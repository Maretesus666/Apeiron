[node name="PuntosSeparador" type="Label" parent="PanelMejoras/Panel/MarginContainer/VBoxContainer"]
layout_mode = 2

[node name="ScrollContainer" type="ScrollContainer" parent="PanelMejoras/Panel/MarginContainer/VBoxContainer"]
layout_mode = 2

[node name="UpgradesVBox" type="VBoxContainer" parent="PanelMejoras/Panel/MarginContainer/VBoxContainer/ScrollContainer"]
layout_mode = 2

[connection signal="scroll_ended" from="ContenedorBotones/ScrollContainer" to="." method="_on_scroll_container_scroll_ended"]
[connection signal="scroll_started" from="ContenedorBotones/ScrollContainer" to="." method="_on_scroll_container_scroll_started"]
[connection signal="pressed" from="ContenedorBotones/ScrollContainer/HBoxContainer/Nave/VBoxContainer/PlayButton" to="." method="_on_play_button_pressed"]
[connection signal="pressed" from="ContenedorBotones/ScrollContainer/HBoxContainer/Nave/VBoxContainer/MejorasNaveBtn" to="." method="_on_mejoras_nave_btn_pressed"]
[connection signal="pressed" from="ContenedorBotones/PanelContainer/HBoxContainer/PanelContainer/Button" to="." method="_on_button_pressed" binds= [0]]
[connection signal="pressed" from="ContenedorBotones/PanelContainer/HBoxContainer/PanelContainer2/Button" to="." method="_on_button_pressed" binds= [1]]
